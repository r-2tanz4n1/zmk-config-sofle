#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <dt-bindings/zmk/pointing.h>

#define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro

&mt {
    tapping-term-ms = <145>;
    quick-tap-ms = <110>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <155>;
            quick_tap_ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        soff: soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            // split-peripheral-off-on-press;
            hold-time-ms = <5000>; // Only turn off it the key is held for 5 seconds or longer.
        };
    };

    combos {
        compatible = "zmk,combos";

        Funct_2 {
            bindings = <&kp F2>;
            key-positions = <2 3>;
        };

        Funct_3 {
            bindings = <&kp F3>;
            key-positions = <3 4>;
        };

        Funct_4 {
            bindings = <&kp F4>;
            key-positions = <5 4>;
        };

        CapsLock {
            bindings = <&kp LS(CAPSLOCK)>;
            key-positions = <13 14>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <14 15>;
        };

        Arroba {
            bindings = <&kp LA(NUMBER_2)>;
            key-positions = <25 26>;
        };

        Euro {
            bindings = <&kp LA(N3)>;
            key-positions = <26 27>;
        };

        AbreColchete {
            bindings = <&kp LA(N8)>;
            key-positions = <28 27>;
        };

        FechaColchete {
            bindings = <&kp LA(N9)>;
            key-positions = <29 28>;
        };

        Menor {
            bindings = <&kp INT1>;
            key-positions = <39 40>;
        };

        Maior {
            bindings = <&kp LS(INT1)>;
            key-positions = <40 41>;
        };

        Asterisco {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <10 9>;
        };

        Plus {
            bindings = <&kp EQUAL>;
            key-positions = <10 11>;
        };

        Ordinal {
            bindings = <&kp LBKT>;
            key-positions = <22 23>;
        };

        SpaceRight {
            bindings = <&kp SPACE>;
            key-positions = <45 46>;
        };

        Layer3 {
            bindings = <&mo 3>;
            key-positions = <56 55>;
        };

        Soft_off_right {
            bindings = <&soff>;
            key-positions = <30 18 44>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&none       AS(N1)      AS(N2)       AS(N3)       AS(N4)        AS(N5)                                                 AS(N6)  AS(N7)       AS(N8)      AS(N9)       AS(N0)          &none
&kp ESC     AS(Q)       AS(W)        AS(E)        AS(R)         AS(T)                                                  AS(Y)   AS(U)        AS(I)       AS(O)        AS(P)           AS(RIGHT_BRACKET)
AS(MINUS)   &hm LCTRL A &hm LALT S   &hm LGUI D   &hm LSHFT F   AS(G)                                                  AS(H)   &hm RSHFT J  &hm RGUI K  &hm RALT L   &hm RCTRL SEMI  AS(SQT)
&caps_word  AS(Z)       AS(X)        AS(C)        AS(V)         AS(B)       &none                          &none       AS(N)   AS(M)        AS(COMMA)   AS(DOT)      AS(SLASH)       &mt RSHFT ENTER
                      &kp C_VOL_DN  &lt 3 C_VOL_UP  &mt LS(LA(LC(LEFT_GUI))) TAB  &lt 1 SPACE  &lt 2 ENTER    &lt 2 BACKSPACE  &lt 1 SPACE  &mt RS(RC(RA(RIGHT_GUI))) DEL  &lt 3 C_BRI_INC  &kp C_BRI_DEC
            >;

            sensor-bindings = 
                <&inc_dec_kp DOWN UP>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        NAV {
            label = "Navigation";
            bindings = <
&none          &kp N6     &kp N7        &kp N8         &kp N9                        &kp N0                                 &kp N1                 &kp N2                                     &kp N3            &kp N4            &kp N5             &kp LG(BACKSPACE)
&kp ESC        &kp LG(Q)  &kp LG(W)     &kp LG(S)      &kp LG(R)                     &kp LG(T)                              &kp LG(T)              &kp LG(I)                                  &kp UP            &kp LC(LS(LEFT))  &kp LC(LS(RIGHT))  &kp DEL
&kp LG(A)      &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI   &kp LSHFT                     &kp LG(F)                              &kp LS(LA(LC(LG(H))))  &kp LEFT                                   &kp DOWN          &kp RIGHT         &kp RIGHT_ALT      &kp RIGHT_GUI
&kp LS(LC(Q))  &kp LG(Z)  &kp LG(X)     &kp LG(C)      &kp LG(V)                     &kp LG(B)  &trans       &trans         &kp SPACE              &kp LG(M)                                  &kp LG(C)         &kp LG(V)         &kp RG(Z)          &kp ENTER
                          &kp K_MUTE    &kp LS(LG(A))  &mt LS(LA(LC(LEFT_GUI))) TAB  &kp SPACE  &kp ENTER    &kp BACKSPACE  &kp SPACE              &mt LC(LS(LA(LEFT_GUI))) LC(LS(UP_ARROW))  &kp LC(LS(DOWN))  &kp LG(H)
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LS(DOWN)) LA(LS(UP))>,
                <&inc_dec_kp LA(LS(RIGHT)) LA(LS(LEFT))>;

        };

        NUM {
            label = "Numpad";
            bindings = <
&kp F12     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5                                    &kp F6         &kp F7      &kp F8     &kp F9      &kp F10    &kp F11
&kp ESC     &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                                &kp LS(N7)     &kp N7      &kp N8     &kp N9      &kp EQUAL  &kp LBKT
&kp LA(N2)  &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT   &kp LS(NUHS)                              &kp LS(EQUAL)  &kp N4      &kp N5     &kp N6      &kp DOT    &kp NON_US_HASH
&kp NUBS    &kp LS(N6)  &kp LA(N3)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)    &trans       &trans         &kp N0         &kp N1      &kp N2     &kp N3      &kp FSLH   &kp ENTER
                        &kp F2      &kp F4      &kp TAB     &kp SPACE     &kp ENTER    &kp BACKSPACE  &kp SPACE      &kp LS(N0)  &kp COMMA  &kp PERIOD
            >;

            sensor-bindings =
                <&inc_dec_kp LA(DOWN) RA(UP)>,
                <&inc_dec_kp LA(RIGHT) LA(LEFT)>;
        };

        FN {
            label = "Functions";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1            &bt BT_SEL 2            &bt BT_SEL 3            &bt BT_CLR              &bt BT_CLR_ALL                            &none           &none          &none          &none          &none          &none
&kp ESC       &kp LS(LA(LC(LG(N1))))  &kp LS(LA(LC(LG(N2))))  &kp LS(LA(LC(LG(N3))))  &kp LS(LA(LC(LG(N4))))  &kp LS(LA(LC(LG(N5))))                    &kp LS(LC(N1))  &kp LS(LC(W))  &kp LS(LC(E))  &kp LS(LC(R))  &kp LS(LC(T))  &kp LS(LC(N3))
&none         &kp LS(LA(LC(LG(N6))))  &kp LS(LA(LC(LG(N7))))  &kp LS(LA(LC(LG(N8))))  &kp LS(LA(LC(LG(N9))))  &kp LS(LA(LC(LG(N0))))                    &kp LS(LC(N2))  &kp LS(LC(S))  &kp LS(LC(D))  &kp LS(LC(F))  &kp LS(LC(G))  &kp LS(LC(N4))
&none         &none                   &kp C_PREVIOUS          &kp C_PLAY_PAUSE        &kp C_NEXT              &none                   &trans    &trans  &kp LS(LC(Z))   &kp LS(LC(X))  &kp LS(LC(C))  &kp LS(LC(V))  &kp LS(LC(B))  &kp LS(LC(N5))
                                      &kp C_VOL_DN            &kp C_VOL_UP            &none                   &none                   &none     &none   &none           &none          &kp C_BRI_INC  &kp C_BRI_DEC
            >;
        };
    };
};
