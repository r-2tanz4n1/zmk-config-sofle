#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro

&mt {
    tapping-term-ms = <145>;
    quick-tap-ms = <110>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        td_ShftCW: td_ShftCW {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHFTCW";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&caps_word>;

            tapping-term-ms = <160>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            bindings = <&shifted>, <&kp>;

            flavor = "tap-preferred";
        };

        soff: soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;

            // split-peripheral-off-on-press;

            hold-time-ms = <5000>; // Only turn off it the key is held for 5 seconds or longer.
        };
    };

    macros {
        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Numpad_On {
            bindings = <&to 1>;
            key-positions = <44 45>;
        };

        Numpad_Off {
            bindings = <&to 0>;
            key-positions = <58 59>;
            layers = <1>;
        };

        Launchpad {
            bindings = <&kp LC(LS(DOWN))>;
            key-positions = <30 31>;
        };

        Asterisco {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <10 9>;
        };

        Plus {
            bindings = <&kp EQUAL>;
            key-positions = <10 11>;
        };

        Ordinal {
            bindings = <&kp LBKT>;
            key-positions = <22 23>;
        };

        Funct_2 {
            bindings = <&kp F2>;
            key-positions = <2 3>;
        };

        Funct_3 {
            bindings = <&kp F3>;
            key-positions = <3 4>;
        };

        Funct_4 {
            bindings = <&kp F4>;
            key-positions = <5 4>;
        };

        Menor {
            bindings = <&kp NUBS>;
            key-positions = <39 40>;
        };

        Maior {
            bindings = <&kp LS(NUBS)>;
            key-positions = <40 41>;
        };

        AbreColchete {
            bindings = <&kp LA(N8)>;
            key-positions = <28 27>;
        };

        FechaColchete {
            bindings = <&kp LA(N9)>;
            key-positions = <29 28>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <13 14>;
        };

        CapsLock {
            bindings = <&kp LS(CAPSLOCK)>;
            key-positions = <12 13>;
        };

        Space {
            bindings = <&kp SPACE>;
            key-positions = <57 58>;
        };

        Delete {
            bindings = <&kp DEL>;
            key-positions = <59 58>;
        };

        Soft_off_right {
            bindings = <&soff>;
            key-positions = <30 18 44>;
        };

        Soft_off_left {
            bindings = <&soff>;
            key-positions = <41 29 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               |CTRL | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   | RALT |

            bindings = <
&kp ESC         &as N1  &as N2              &as N3    &as N4                         &as N5                                                                  &as N6       &as N7             &as N8     &as N9      &as N0              &as MINUS
&kp TAB         &as Q   &as W               &as E     &as R                          &as T                                                                   &as Y        &as U              &as I      &as O       &as P               &as RIGHT_BRACKET
&kp LEFT_ALT    &as A   &as S               &as D     &as F                          &as G                                                                   &as H        &as J              &as K      &as L       &mt RIGHT_ALT SEMI  &as SQT
&kp LEFT_SHIFT  &as Z   &as X               &as C     &as V                          &as B               &mkp MB3       &caps_word                           &as N        &as M              &as COMMA  &as PERIOD  &as SLASH           &mt RSHFT ENTER
                        &mt LCTRL LA(LEFT)  &lt 3 UP  &mt LS(LA(LC(LEFT_GUI))) DOWN  &mt LEFT_GUI RIGHT  &lt 2 ENTER    &mt RS(RA(RC(RIGHT_GUI))) BACKSPACE  &lt 2 SPACE  &mt RIGHT_GUI DEL  &kp UP     &kp DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN_ARROW UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;

            label = "Base";
        };

        NUM {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp GRAVE  &kp F1     &kp F2            &kp F3        &kp F4        &kp F5                                  &kp LA(N3)     &kp NUBS    &kp LS(N8)  &kp LS(N9)  &kp LS(NUBS)  &kp DELETE
&kp TAB    &kp F6     &kp F7            &kp F8        &kp F9        &kp F10                                 &kp LS(N7)     &kp N7      &kp N8      &kp N9      &none         &kp LBKT
&kp LALT   &kp F11    &kp F12           &kp LA(N0)    &kp LA(N8)    &kp LA(N9)                              &kp LS(EQUAL)  &kp N4      &kp N5      &kp N6      &kp EQUAL     &kp NON_US_HASH
&kp LSHFT  &kp MINUS  &kp LS(N2)        &kp LS(N3)    &kp LS(N4)    &kp LS(N5)  &trans       &trans         &kp N0         &kp N1      &kp N2      &kp N3      &kp FSLH      &trans
                      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE   &kp ENTER    &kp BACKSPACE  &kp SPACE      &kp LS(N0)  &kp COMMA   &kp PERIOD
            >;

            sensor-bindings =
                <&inc_dec_kp LA(DOWN) RA(UP)>,
                <&inc_dec_kp LA(RIGHT) LA(LEFT)>;

            label = "Numpad";
        };

        FUNCT {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&none      &kp LS(LA(LC(LG(N1))))  &kp LS(LA(LC(LG(N2))))  &kp LS(LA(LC(LG(N3))))  &kp LG(LS(LA(LC(N4))))  &kp LS(LA(LC(LG(N5))))                              &kp N1            &kp N2     &kp N3     &kp N4             &kp N5            &kp LG(BACKSPACE)
&kp TAB    &kp CAPSLOCK            &kp LS(LA(LC(LG(W))))   &kp LS(LA(LC(LG(E))))   &kp LG(LS(LA(LC(R))))   &kp LS(LA(LC(LG(T))))                               &kp LS(LC(UP))    &kp RG(T)  &kp UP     &kp LC(LS(RIGHT))  &kp LS(LC(LEFT))  &kp RIGHT_GUI
&kp LALT   &kp LS(LA(LC(LG(A))))   &kp LS(LA(LC(LG(S))))   &kp LS(LA(LC(LG(D))))   &kp LG(LS(LA(LC(F))))   &kp LS(LA(LC(LG(G))))                               &kp LC(LS(DOWN))  &kp LEFT   &kp DOWN   &kp RIGHT          &kp SPACE         &kp RIGHT_ALT
&kp LSHFT  &kp LS(LA(LC(LG(Z))))   &kp LS(LA(LC(LG(X))))   &kp LS(LA(LC(LG(C))))   &kp LG(LS(LA(LC(V))))   &kp LS(LA(LC(LG(B))))   &trans       &trans         &kp LG(B)         &kp RG(W)  &kp LG(C)  &kp LG(V)          &kp RG(Z)         &kp RG(ENTER)
                                   &kp LS(LC(Q))           &trans                  &kp LEFT_GUI            &kp SPACE               &kp ENTER    &kp BACKSPACE  &kp SPACE         &kp TAB    &none      &kp DEL
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LS(DOWN)) LA(LS(UP))>,
                <&inc_dec_kp LA(LS(RIGHT)) LA(LS(LEFT))>;

            label = "Function";
        };

        BT-WM {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR  &none                 &none             &none                 &none                                 &kp LS(LC(N1))  &kp LC(LS(N2))  &kp LS(LC(N3))  &kp LS(LC(N4))  &kp LC(LS(N5))  &kp LC(LS(N6))
&none           &none       &kp C_BRIGHTNESS_DEC  &none             &kp C_BRIGHTNESS_INC  &none                                 &none           &kp LS(LC(W))   &kp LS(LC(E))   &kp LS(LC(R))   &kp LS(LC(T))   &kp LS(LC(Y))
&none           &none       &kp C_VOLUME_DOWN     &kp K_MUTE        &kp C_VOL_UP          &none                                 &kp LS(LC(A))   &kp LS(LC(S))   &kp LS(LC(D))   &kp LS(LC(F))   &kp LS(LC(G))   &kp LS(LC(H))
&none           &none       &kp C_PREVIOUS        &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD    &none         &trans          &trans  &kp LS(LC(Z))   &kp LS(LC(X))   &kp LS(LC(C))   &kp LS(LC(V))   &kp LS(LC(B))   &kp LS(LC(N))
                            &bt BT_SEL 0          &bt BT_SEL 1      &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4    &none   &kp SPACE       &none           &none           &none
            >;

            label = "Window Management";
        };
    };
};
