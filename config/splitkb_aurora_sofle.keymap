#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro

&mt {
    tapping-term-ms = <145>;
    quick-tap-ms = <110>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        td_ShftCW: td_ShftCW {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHFTCW";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&caps_word>;

            tapping-term-ms = <160>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            bindings = <&shifted>, <&kp>;

            flavor = "tap-preferred";
        };

        soff: soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;

            // split-peripheral-off-on-press;

            hold-time-ms = <5000>; // Only turn off it the key is held for 5 seconds or longer.
        };
    };

    macros {
        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Funct_2 {
            bindings = <&kp F2>;
            key-positions = <2 3>;
        };

        Funct_3 {
            bindings = <&kp F3>;
            key-positions = <3 4>;
        };

        Funct_4 {
            bindings = <&kp F4>;
            key-positions = <5 4>;
        };

        CapsLock {
            bindings = <&kp LS(CAPSLOCK)>;
            key-positions = <13 14>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <14 15>;
        };

        Arroba {
            bindings = <&kp LA(NUMBER_2)>;
            key-positions = <25 26>;
        };

        Euro {
            bindings = <&kp LA(N3)>;
            key-positions = <26 27>;
        };

        AbreColchete {
            bindings = <&kp LA(N8)>;
            key-positions = <28 27>;
        };

        FechaColchete {
            bindings = <&kp LA(N9)>;
            key-positions = <29 28>;
        };

        Menor {
            bindings = <&kp INT1>;
            key-positions = <39 40>;
        };

        Maior {
            bindings = <&kp LS(INT1)>;
            key-positions = <40 41>;
        };

        Asterisco {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <10 9>;
        };

        Plus {
            bindings = <&kp EQUAL>;
            key-positions = <10 11>;
        };

        Ordinal {
            bindings = <&kp LBKT>;
            key-positions = <22 23>;
        };

        Numpad_On {
            bindings = <&to 2>;
            key-positions = <44 45>;
        };

        SpaceRight {
            bindings = <&kp SPACE>;
            key-positions = <45 46>;
        };

        Numpad_Off {
            bindings = <&to 0>;
            key-positions = <48 49>;
            layers = <2>;
        };

        Layer3 {
            bindings = <&mo 3>;
            key-positions = <56 55>;
        };

        Raycast {
            bindings = <&kp LS(LC(LA(LG(SPACE))))>;
            key-positions = <31 32>;
        };

        Soft_off_right {
            bindings = <&soff>;
            key-positions = <30 18 44>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               |CTRL | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   | RALT |

            bindings = <
&kp ESC         &as N1  &as N2          &as N3       &as N4                        &as N5                                                      &as N6  &as N7                     &as N8     &as N9      &as N0              &as MINUS
&kp TAB         &as Q   &as W           &as E        &as R                         &as T                                                       &as Y   &as U                      &as I      &as O       &as P               &as RIGHT_BRACKET
&kp LEFT_ALT    &as A   &as S           &as D        &as F                         &as G                                                       &as H   &as J                      &as K      &as L       &mt RIGHT_ALT SEMI  &as SQT
&kp LEFT_SHIFT  &as Z   &as X           &as C        &as V                         &as B               &mkp MB3       &caps_word               &as N   &as M                      &as COMMA  &as PERIOD  &as SLASH           &mt RSHFT ENTER
                        &mt LCTRL LEFT  &lt 3 RIGHT  &mt LS(LA(LC(LEFT_GUI))) DEL  &mt LEFT_GUI SPACE  &lt 2 ENTER    &mt RIGHT_GUI BACKSPACE  &mo 2   &kp RS(RA(RC(RIGHT_GUI)))  &lt 3 UP   &kp DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN_ARROW UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;

            label = "Base";
        };

        NUM {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp NUBS   &kp F1     &kp F2            &kp F3        &kp F4                    &kp F5                                    &kp LA(N3)     &kp GRAVE   &kp LS(N8)  &kp LS(N9)  &kp LS(GRAVE)  &kp EQUAL
&kp TAB    &kp F6     &kp F7            &kp F8        &kp F9                    &kp F10                                   &kp LS(N7)     &kp N7      &kp N8      &kp N9      &kp COMMA      &kp LBKT
&kp LALT   &kp F11    &kp F12           &kp LA(N0)    &kp LA(N8)                &kp LA(N9)                                &kp LS(EQUAL)  &kp N4      &kp N5      &kp N6      &kp DOT        &kp NON_US_HASH
&kp LSHFT  &kp MINUS  &kp LS(N2)        &kp LS(N3)    &kp LS(N4)                &kp LS(N5)    &trans       &trans         &kp N0         &kp N1      &kp N2      &kp N3      &kp FSLH       &trans
                      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LS(LA(LC(LEFT_GUI)))  &kp LEFT_GUI  &kp ENTER    &kp BACKSPACE  &kp SPACE      &kp LS(N0)  &kp COMMA   &kp PERIOD
            >;

            sensor-bindings =
                <&inc_dec_kp LA(DOWN) RA(UP)>,
                <&inc_dec_kp LA(RIGHT) LA(LEFT)>;

            label = "Numpad";
        };

        FUNCT {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&none      &kp LS(LA(LC(LG(N1))))  &kp C_PLAY_PAUSE  &kp C_PREVIOUS        &kp C_FAST_FORWARD        &kp LS(LA(LC(LG(N5))))                              &kp N1                 &kp N2                &kp N3     &kp N4     &kp N5            &kp LG(BACKSPACE)
&kp TAB    &kp CAPSLOCK            &kp LG(W)         &kp C_BRIGHTNESS_DEC  &kp C_BRI_INC             &kp LG(T)                                           &kp RG(T)              &kp LS(LC(UP_ARROW))  &kp UP     &kp RG(O)  &kp LS(LC(LEFT))  &kp DEL
&kp LALT   &none                   &kp K_MUTE        &kp C_VOL_DN          &kp C_VOLUME_UP           &none                                               &kp LC(LS(LA(LG(H))))  &kp LEFT              &kp DOWN   &kp RIGHT  &kp RIGHT_ALT     &kp RIGHT_GUI
&kp LSHFT  &kp LG(Z)               &kp LG(X)         &kp LG(C)             &kp LG(V)                 &kp LG(B)               &trans       &trans         &kp RG(W)              &kp SPACE             &kp LG(C)  &kp LG(V)  &kp RG(Z)         &mt RIGHT_SHIFT ENTER
                                   &kp LS(LC(Q))     &kp LEFT_ALT          &kp LS(LA(LC(LEFT_GUI)))  &kp LEFT_GUI            &kp ENTER    &kp BACKSPACE  &kp RG(SPACE)          &kp TAB               &none      &none
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LS(DOWN)) LA(LS(UP))>,
                <&inc_dec_kp LA(LS(RIGHT)) LA(LS(LEFT))>;

            label = "Function";
        };

        L3 {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none  &none                    &kp LS(LC(N1))  &kp LC(LS(N2))  &kp LS(LC(N3))  &kp LS(LC(N4))  &kp LC(LS(N5))  &kp LC(LS(N6))
&none           &none         &none         &none         &none  &none                    &none           &kp LS(LC(W))   &kp LS(LC(E))   &kp LS(LC(R))   &kp LS(LC(T))   &kp LS(LC(Y))
&none           &none         &none         &none         &none  &none                    &kp LS(LC(A))   &kp LS(LC(S))   &kp LS(LC(D))   &kp LS(LC(F))   &kp LS(LC(G))   &kp LS(LC(H))
&bt BT_CLR_ALL  &bt BT_CLR    &none         &none         &none  &none  &trans    &trans  &kp LS(LC(Z))   &kp LS(LC(X))   &kp LS(LC(C))   &kp LS(LC(V))   &kp LS(LC(B))   &kp LS(LC(N))
                              &none         &none         &none  &none  &none     &none   &none           &none           &none           &none
            >;

            label = "Window Management";
        };
    };
};
