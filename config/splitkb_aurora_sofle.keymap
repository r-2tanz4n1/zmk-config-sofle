#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <dt-bindings/zmk/pointing.h>

#define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro

&mt {
    tapping-term-ms = <145>;
    quick-tap-ms = <110>;
    flavor = "tap-preferred";
};

/ {
    behaviors {

        td_ShftCW: td_ShftCW {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHFTCW";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&caps_word>;
            tapping-term-ms = <150>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <160>;
            quick_tap_ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        soff: soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            // split-peripheral-off-on-press;
            hold-time-ms = <5000>; // Only turn off it the key is held for 5 seconds or longer.
        };
    };


    combos {
        compatible = "zmk,combos";

        Soft_off_right {
            bindings = <&soff>;
            key-positions = <30 18 44>;
        };

        Soft_off_left {
            bindings = <&soff>;
            key-positions = <41 29 17>;
        };

        Numpad_On {
            bindings = <&to 1>;
            key-positions = <55 56>;
        };

        Numpad_Off {
            bindings = <&to 0>;
            key-positions = <58 59>;
        };

        Funct_2 {
            bindings = <&kp F2>;
            key-positions = <38 39>;
        };

        Funct_4 {
            bindings = <&kp F4>;
            key-positions = <39 40>;
        };

        Arroba {
            bindings = <&kp LA(NUMBER_2)>;
            key-positions = <26 27>;
        };

        Euro {
            bindings = <&kp LA(N3)>;
            key-positions = <27 28>;
        };

        Plus {
            bindings = <&kp EQUAL>;
            key-positions = <10 11>;
        };

        Ordinal {
            bindings = <&kp LBKT>;
            key-positions = <22 23>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <14 15>;
        };

        CapsLock {
            bindings = <&kp LS(CAPSLOCK)>;
            key-positions = <15 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // ------------------------------------------------------------------------------------------------------------
            // |  Esc |  1  |   2  |   3  |   4   |   5   | Down |   | Right |   6   |  7  |   8  |   9  |   0   |   '/?   |
            // |  Tab |  q  |   w  |   e  |   r   |   t   |  Up  |   |  Left |   y   |  u  |   i  |   o  |   p   |    ´    |
            // |  Opt |  a  |   s  |   d  |   f   |   g   |      |   |       |   h   |  j  |   k  |   l  | ç/Opt |   ~/^   |
            // | Shft |  z  |   x  |   c  |   v   |   b   |      |   |       |   n   |  m  |   ,  |   .  |   -   | Ent/Shf |
            // |      |     |   @  | Left | Right | Space |  Ent |   | Bkspc | Space |  Up | Down |  Del |       |         |
            // |      |     | Ctrl | Hypr |  Cmd  |  Num  |  Nav |   |  Cmd  |  Num  | Nav | Hypr | Wind |       |         |

            bindings = <
&kp ESC       AS(N1)  AS(N2)      AS(N3)          AS(N4)              AS(N5)                                          AS(N6)               AS(N7)    AS(N8)      AS(N9)                       AS(N0)                  AS(MINUS)
&kp TAB       AS(Q)   AS(W)       AS(E)           AS(R)               AS(T)                                           AS(Y)                AS(U)     AS(I)       AS(O)                        AS(P)                   AS(RIGHT_BRACKET)
&kp LEFT_ALT  AS(A)   AS(S)       AS(D)           AS(F)               AS(G)                                           AS(H)                AS(J)     AS(K)       AS(L)                        &mt LEFT_ALT SEMICOLON  AS(SQT)
&td_ShftCW    AS(Z)   AS(X)       AS(C)           AS(V)               AS(B)           &mkp MB3       &caps_word       AS(N)                AS(M)     AS(COMMA)         AS(DOT)          AS(SLASH)         &mt RSHFT ENTER
                      &mt LCTRL LA(NUMBER_2)  &mt LC(LS(LG(LEFT_ALT))) LEFT  &mt LEFT_GUI RIGHT  &lt 1 SPACE  &lt 2 ENTER    &mt RIGHT_GUI BACKSPACE  &lt 1 SPACE  &lt 2 UP  &mt LS(LC(LG(RIGHT_ALT))) DOWN  &lt 3 DELETE
            >;

            sensor-bindings = 
                <&inc_dec_kp DOWN UP>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        NUM {
            // ------------------------------------------------------------------------------------------------------------
            // |  CW  | F1 |  F2  |  F3  |  F4 |   F5  | Opt+D |   | Opt+R |   F6  |  F7 |  F8  |  F9  | F10 |  Del |
            // |  Tab |  § |   %  |   #  |  (  |   )   | Opt+U |   | Opt+L |   /   |  7  |   8  |   9  |  ≠  |   º  |
            // |  Opt |    |   @  |   €  |  [  |   ]   |       |   |       |   *   |  4  |   5  |   6  |  +  |   \  |
            // | Shft |    |  F2  |   '  |  <  |   >   |       |   |       |   0   |  1  |   2  |   3  |  -  | Entr |
            // |      |    | Ctrl |  Opt | Cmd | Space | Enter |   | Bkspc | Space |  =  |   ,  |   .  |     |      |

            bindings = <
&caps_word  &kp F1               &kp F2            &kp F3        &kp F4        &kp F5                                           &kp F6         &kp F7      &kp F8     &kp F9      &kp F10     &kp DELETE
&kp TAB     &kp GRAVE            &kp LS(N5)        &kp LS(N3)    &kp LS(N8)    &kp LS(N9)                                       &kp LS(N7)     &kp N7      &kp N8     &kp N9      &kp LA(N0)  &kp LBKT
&kp LALT    &none                &kp LA(N2)        &kp LA(N3)    &kp LA(N8)    &kp LA(N9)                                       &kp LS(EQUAL)  &kp N4      &kp N5     &kp N6      &kp EQUAL   &kp NON_US_HASH
&kp LSHFT   &none                &kp F2            &kp MINUS     &kp INT1      &kp LS(NON_US_BSLH)  &trans       &trans         &kp N0         &kp N1      &kp N2     &kp N3      &kp FSLH    &trans
                                 &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE            &kp ENTER    &kp BACKSPACE  &kp SPACE      &kp LS(N0)  &kp COMMA  &kp PERIOD
            >;

            sensor-bindings =
                <&inc_dec_kp LA(DOWN) RA(UP)>,
                <&inc_dec_kp LA(RIGHT) LA(LEFT)>;
        };

        NAV {
            // ------------------------------------------------------------------------------------------------------------
            // |  CL  |   F11  |  F12  |  F13 |  F14  |  F15  |  MW+R |   | Ctrl+R |  F16   |  F17  |  F18  |  F19  | F20 |    DEL   |
            // |  tab |        | Brgt- | Brgt+| MWh L | MWh R |  MW+L |   | Ctrl+L |MissCtrl|OptTab |  Up   |AppWind|Desk |  CMD+Bks |
            // |  Opt |        |       | Mute | Vol - | Vol + |       |   |        | Launch | Left  |  Down | Right | Opt |   Space  |
            // | Shft |        |       | Play |  Prev |  Next |       |   |        |CloseTab|InsLink|  Copy | Paste |Undo | Entr/Shf |
            // |      |        |ScrnSvr|  Opt |  Cmd  | Space | Enter |   |  Bkspc | space  |  Tab  | trans |Opt+Bks|     |          |

            bindings = <
&kp CAPSLOCK  &kp F11  &kp F12               &kp F13               &kp F14          &kp F15                                  &kp F16           &kp F17           &kp F18       &kp F19            &kp F20        &kp DEL
&kp TAB       &none    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &msc SCRL_RIGHT  &msc SCRL_LEFT                           &kp LC(LS(UP))    &kp LS(LC(LEFT))  &kp UP_ARROW  &kp LC(LS(RIGHT))  &none          &kp RG(BACKSPACE)
&kp LALT      &none    &none                 &kp K_MUTE            &kp C_VOL_DN     &kp C_VOL_UP                             &kp LC(LS(DOWN))  &kp LEFT_ARROW    &kp DOWN      &kp RIGHT          &kp RIGHT_ALT  &kp SPACE
&kp LSHFT     &none    &none                 &kp C_PLAY            &kp C_PREV       &kp C_NEXT      &trans    &trans         &kp LG(W)         &kp RG(K)         &kp LG(C)     &kp LG(V)          &kp RG(Z)      &trans
                       &kp LS(LC(Q))         &trans                &trans           &trans          &trans    &kp BACKSPACE  &kp SPACE         &kp TAB           &none         &kp RA(BACKSPACE)
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LS(DOWN)) LA(LS(UP))>,
                <&inc_dec_kp LA(LS(RIGHT)) LA(LS(LEFT))>;
        };

        SHORT-BT {
            // ------------------------------------------------------------------------------------------------------------
            // | Clear All |          |          |           |           |           |     |   |   |   |          |   MBP    |   Work   |   Home    |    Full   |
            // |           |          | 3/4 Left |  3/4 Cntr | 3/4 Right |  1/2 top  |     |   |   |   |          | 3/4 Left | 3/4 Cntr | 3/4 Right |  1/2 top  |
            // |           | M. Outlk | 2/3 Left |  2/3 Cntr | 2/3 Right | Next Disp |     |   |   |   | L Middle | 2/3 Left | 2/3 Cntr | 2/3 Right | Next Disp |
            // |  Clear BT | M. Cornr | 1/2 Left |  1/2 Cntr | 1/2 Right |  1/2 bot  |     |   |   |   | R InfCnr | 1/2 Left | 1/2 Cntr | 1/2 Right |  1/2 bot  |
            // |           |          |    BT0   |    BT1    |    BT2    |    BT3    | BT4 |   |   |   |          |          |          |     L3    |           |


            bindings = <
&bt BT_CLR_ALL  &kp LS(LG(N1))  &kp LS(LG(N2))  &kp LS(LG(NUMBER_3))  &kp LG(LS(N4))  &kp LG(LS(N5))                          &none   &kp LS(LC(N1))  &kp LC(LS(N2))  &kp LS(LC(N3))  &kp LS(LC(N4))  &kp LC(LS(N5))
&none           &none           &kp LS(LC(W))   &kp LS(LC(E))         &kp LS(LC(R))   &kp LS(LC(T))                           &none   &none           &kp LS(LC(W))   &kp LS(LC(E))   &kp LS(LC(R))   &kp LS(LC(T))
&none           &kp LS(LC(A))   &kp LS(LC(S))   &kp LS(LC(D))         &kp LS(LC(F))   &kp LS(LC(G))                           &none   &kp LS(LC(A))   &kp LS(LC(S))   &kp LS(LC(D))   &kp LS(LC(F))   &kp LS(LC(G))
&bt BT_CLR      &kp LS(LC(Z))   &kp LS(LC(X))   &kp LS(LC(C))         &kp LS(LC(V))   &kp LS(LC(B))   &trans          &trans  &none   &kp LS(LC(Z))   &kp LS(LC(X))   &kp LS(LC(C))   &kp LS(LC(V))   &kp LS(LC(B))
                                &bt BT_SEL 0    &bt BT_SEL 1          &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans  &trans  &none           &none           &none
            >;
        };
    };
};
